  ,MC.MEMBER_ACCOUNT_ID_NH
  ,TO_DATE('01012027','MMDDYYYY') AS SPAN_START_DT
  ,TO_DATE('12312027','MMDDYYYY') AS SPAN_END_DT
  ,NVL(FP.INDIVIDUAL_RATE,0) AS PREMIUM_RATE
  ,PS.APTC
  ,
PS.NEWBORN_ADJ
  ,PS.NEWBORN_DT
  ,PS.OTHER_PAY
  ,PS.ADOPTED_DT
  ,CAST(CAST(LIS.PREMIUMSUBSIDYPERCENT AS NUMBER)/100 AS VARCHAR2(100)) AS PREMIUMSUBSIDYPERCENT
  ,NVL(FP.PARTD_PREM,0) AS PARTD_PREM
  ,
CAST(NULL AS VARCHAR2(10)) AS PREM_DIRECT_PAY
  ,CASE 
  WHEN PPO.PPO='D' 
  THEN NULL 
  WHEN PPO.PPO='S' 
  THEN 'SSA' 
  WHEN PPO.PPO='R' 
  THEN 'RRB' 
  END AS PREM_WITHHOLD_SOURCE
  ,NVL(LEP.LEP,0) AS PART_D_LEP
  ,
NVL(FP.PARTD_BASE,0) AS PARTD_BASE
  ,
RANK() OVER(PARTITION BY MC.MEMBER_ACCOUNT_ID_NH, MC.MEMBER_COVERAGE_ID_NH 
  ORDER BY PS.SPAN_END_DT DESC , PS.SPAN_START_DT DESC, PREMIUM_SPAN_ID_NH DESC) AS RNK

  FROM mbrprofile.member_profile mp

  INNER JOIN mbrprofile.health_coverage hc 
  ON mp.member_profile_id_nh=hc.member_profile_id_nh

  INNER JOIN BILLPAY.MEMBER_ACCOUNT MA 
  ON HC.MEMBER_PROFILE_ID_NH=MA.MEMBER_PROFILE_ID_NH

  INNER JOIN BILLPAY.MEMBER_COVERAGE MC 
  ON MA.MEMBER_ACCOUNT_ID_NH=MC.MEMBER_ACCOUNT_ID_NH 
  AND HC.HEALTH_COVERAGE_ID_NH=MC.HEALTH_COVERAGE_ID_NH

  INNER JOIN BILLPAY.PREMIUM_SPAN PS 
  ON MC.MEMBER_COVERAGE_ID_NH=PS.MEMBER_COVERAGE_ID_NH

  LEFT OUTER JOIN (
  SELECT * 
  FROM MBRPROFILE.LOWINCOMESUBSIDY A 
  WHERE NVL(DELETE_FLG,'N')='N' 
  AND NVL(LIS_REMOVED_FLG,'N')='N' 
  AND NVL(TO_CHAR(STOP_DT,'YYYY'),'2027')>='2027') LIS

  ON HC.MEMBER_PROFILE_ID_NH=LIS.MEMBER_PROFILE_ID_NH

  LEFT OUTER JOIN (
  SELECT * 
  FROM MBRPROFILE.MEMBER_LEP A 
  WHERE NVL(DELETE_FLG,'N')='N' 
  AND NVL(TO_CHAR(END_DATE,'YYYY'),'2027')>='2027' ) LEP

  ON HC.MEMBER_PROFILE_ID_NH=LEP.MEMBER_PROFILE_ID_NH

  LEFT OUTER JOIN (
  SELECT * 
  FROM MBRPROFILE.MEMBER_PPO A 
  WHERE NVL(DELETE_FLG,'N')='N' 
  AND NVL(TO_CHAR(END_DATE,'YYYY'),'2027')>='2027') PPO

  ON HC.MEMBER_PROFILE_ID_NH=PPO.MEMBER_PROFILE_ID_NH

