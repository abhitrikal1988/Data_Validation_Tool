2026-10-27 10:49:18,881 | INFO | TestCase 26: Source [ORACLE]:WITH rollover_excluded_mbrs AS (

  SELECT 
  DISTINCT mp.mbi,
  mp.member_profile_id_nh,
  mp.business_id_nh 
  FROM mbrprofile.health_coverage hc 

  INNER JOIN mbrprofile.member_profile mp 
  ON hc.member_profile_id_nh=mp.member_profile_id_nh 

  WHERE hc.benefit_begin_dt BETWEEN TO_DATE('01012027', 'MMDDYYYY') 
  AND TO_DATE('12312027', 'MMDDYYYY') 

  AND hc.benefit_end_dt BETWEEN TO_DATE('01012027', 'MMDDYYYY') 
  AND TO_DATE('12312027', 'MMDDYYYY')

  AND hc.Enrollment_status_id IN (200004,
  200005) 

  AND sep_reason<>'SEP_ROL' 

  UNION ALL 

  SELECT 
  DISTINCT mbi,
  mbr.member_profile_id_nh,
  mbr.business_id_nh 
  FROM mbrexcep.member mbr

  INNER JOIN mbrexcep.member_error mbr_er 
  ON mbr.member_id_nh=mbr_er.member_id_nh 
  AND mbr_er.error_status_id=170105 

  INNER JOIN mbrexcep.health_coverage hc 
  ON mbr.member_id_nh=hc.member_id_nh 

  WHERE mbr.maintenance_type_code='021' 

  AND TO_DATE(hc.benefit_begin_dt DEFAULT NULL 
  ON CONVERSION ERROR, 'YYYYMMDD')BETWEEN TO_DATE('01012027', 'MMDDYYYY')
  AND TO_DATE('12312027', 'MMDDYYYY')

  AND TO_DATE(hc.benefit_end_dt DEFAULT NULL 
  ON CONVERSION ERROR, 'YYYYMMDD') BETWEEN TO_DATE('01012027', 'MMDDYYYY') 
  AND TO_DATE('12312027', 'MMDDYYYY')

  UNION ALL 

  SELECT 
  DISTINCT mp.mbi,
  mp.member_profile_id_nh,
  mp.business_id_nh 
  FROM mbrprofile.member_profile mp

  INNER JOIN mbrprofile.health_coverage hc 
  ON mp.member_profile_id_nh=hc.member_profile_id_nh

  WHERE hc.Enrollment_status_id=200004 

  AND trunc(hc.benefit_begin_dt) BETWEEN TO_DATE('01012026', 'MMDDYYYY') 
  AND TO_DATE('12312026', 'MMDDYYYY')

  AND trunc(hc.benefit_end_dt)=TO_DATE('12312026', 'MMDDYYYY') 

  AND hc.term_rsn_code IS NULL 

  AND hc.plan_id='H3551002000'

  UNION ALL

  SELECT 
  DISTINCT mp.mbi,
  mp.member_profile_id_nh,
  mp.business_id_nh 
  FROM mbrprofile.member_profile mp 

  INNER JOIN mbrprofile.health_coverage hc 
  ON mp.member_profile_id_nh=hc.member_profile_id_nh 

  INNER JOIN mbrprofile.mbr_address ma 
  ON mp.member_profile_id_nh=ma.member_profile_id_nh 

  AND upper(ma.address_type)='RESIDENTIAL'

  AND upper(ma.county)='PIMA' 

  WHERE hc.Enrollment_status_id=200004 

  AND trunc(hc.benefit_begin_dt) BETWEEN TO_DATE('01012026', 'MMDDYYYY')
  AND TO_DATE('12312026', 'MMDDYYYY') 

  AND trunc(hc.benefit_end_dt)=TO_DATE('12312026', 'MMDDYYYY')

  AND hc.term_rsn_code IS NULL

  AND hc.plan_id LIKE'H3551004%')



  SELECT 
  DISTINCT M.MBI
  ,M.MEMBER_ID_NH
  ,'2100A' AS LOOP_QUALF
  ,CAST(NULL AS VARCHAR2(100)) AS ENTITY_ID_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS ENTITIY_TYPE_QUALF
  ,MP.LAST_NM AS NAME_LAST_ORG_NAME
  ,MP.FIRST_NM AS NAME_FIRST
  ,
 MP.MIDDLE_NM AS NAME_MIDDLE
  ,MP.PREFIX AS NAME_PREFIX
  ,MP.SUFFIX AS NAME_SUFFIX
  ,MP.SSN
  ,CAST(NULL AS VARCHAR2(100)) AS CUSTOM_ID
  ,CAST(NULL AS VARCHAR2(100)) AS ADDRESS_INFO_1
  ,
 CAST(NULL AS VARCHAR2(100)) AS ADDRESS_INFO_2
  ,CAST(NULL AS VARCHAR2(100)) AS CITY_NAME
  ,CAST(NULL AS VARCHAR2(100)) AS STATE_PROV_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS POSTAL_CODE
  ,
 CAST(NULL AS VARCHAR2(100)) AS COUNTRY_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS LOCATION_QUALF
  ,CAST(NULL AS VARCHAR2(100)) AS LOCATION_IDENTIFIER
  ,CAST(NULL AS VARCHAR2(100)) AS COUNTRY_SUB_CODE
  ,
 TO_CHAR(MP.BIRTH_DATE, 'YYYYMMDD') AS BIRTH_DATE
  ,MP.GENDER_CODE
  ,MP.MARITAL_STATUS_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS RACE_ETHNICITY_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS RACE_ETHNICITY_CLASS
  ,MP.CITIZENSHIP_STATUS_CODE
  ,
 CAST(NULL AS VARCHAR2(100)) AS RACE_ETHNICITY_COLLECTION
  ,CAST(NULL AS VARCHAR2(100)) AS INCOME_FREQUENCY_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS WAGE_AMT
  ,CAST(NULL AS VARCHAR2(100)) AS WORK_HOURS_COUNT
  ,
 CAST(NULL AS VARCHAR2(100)) AS EMP_LOCATION_IDENT
  ,CAST(NULL AS VARCHAR2(100)) AS SALARY_GRADE
  ,MP.HEALTH_REL_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS HEIGHT
  ,CAST(NULL AS VARCHAR2(100)) AS WEIGHT
  ,
 CAST(NULL AS VARCHAR2(100)) AS CONTACT_FUNCT_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_1
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_1
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_2
  ,
 CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_2
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_3
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_3
  ,CAST(NULL AS VARCHAR2(100)) AS CONTACT_NAME
  ,
 CAST(NULL AS VARCHAR2(100)) AS NON_BINARY
  ,CAST(NULL AS VARCHAR2(100)) AS RELATION_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS AUTH_REP_TYPE
  ,CAST(NULL AS VARCHAR2(100)) AS DOC_LOCATION
  ,CAST(NULL AS VARCHAR2(100)) AS ADOPTED_DT
  ,
 'N' AS PRIMARY_COMM_NUMBER_1
  ,'N' AS PRIMARY_COMM_NUMBER_2
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_4
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_4
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_5
  ,
 CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_5
  ,CAST(NULL AS VARCHAR2(100)) AS RESP_PERSON_END_DT
  ,CAST(NULL AS VARCHAR2(100)) AS MBRPROFILE_RESP_PERSON_ID_NH
  ,CAST(NULL AS VARCHAR2(100)) AS GENDER_IDENTITY_OTHER
  ,
 CAST(NULL AS VARCHAR2(100)) AS SELF_IDENTITY
  ,CAST(NULL AS VARCHAR2(100)) AS SELF_IDENTITY_OTHER
  ,CAST(NULL AS VARCHAR2(100)) AS GENDER_IDENTITY

  FROM mbrprofile.member_profile mp

  INNER JOIN mbrprofile.Health_coverage hc 
  on mp.member_profile_id_nh=hc.member_profile_id_nh

  LEFT OUTER JOIN (
  SELECT M.MBI,
  M.MEMBER_ID_NH 
  FROM mbrexcep.MEMBER M
 
  INNER JOIN mbrexcep.trans_set_header tsh 
  ON M.trans_set_header_id_nh = tsh.trans_set_header_id_nh 
  AND tsh.FILE_DETAIL_ID_NH=0 
  AND tsh.trans_set_date = '20261023' ) M 
  ON Mp.MBI=M.MBI

  WHERE hc.enrollment_status_id=200004 

  AND trunc(hc.benefit_begin_dt) BETWEEN TO_DATE('01012026', 'MMDDYYYY')
  AND TO_DATE('12312026', 'MMDDYYYY')

  AND trunc(hc.benefit_end_dt)=TO_DATE('12312026', 'MMDDYYYY')
  AND
hc.term_rsn_code IS NULL

  AND(mp.member_profile_id_nh NOT IN( 
  SELECT member_profile_id_nh 
  FROM rollover_excluded_mbrs)

  OR mp.mbi NOT IN( 
  SELECT nvl(mbi, '~') AS mbi 
  FROM rollover_excluded_mbrs))

  AND mp.business_id_nh='110'
