  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_1
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_2
  ,
 CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_2
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_3
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_3
  ,CAST(NULL AS VARCHAR2(100)) AS CONTACT_NAME
  ,
 CAST(NULL AS VARCHAR2(100)) AS NON_BINARY
  ,CAST(NULL AS VARCHAR2(100)) AS RELATION_CODE
  ,CAST(NULL AS VARCHAR2(100)) AS AUTH_REP_TYPE
  ,CAST(NULL AS VARCHAR2(100)) AS DOC_LOCATION
  ,CAST(NULL AS VARCHAR2(100)) AS ADOPTED_DT
  ,
 'N' AS PRIMARY_COMM_NUMBER_1
  ,'N' AS PRIMARY_COMM_NUMBER_2
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_4
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_4
  ,CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_QUALF_5
  ,
 CAST(NULL AS VARCHAR2(100)) AS COMM_NUMBER_5
  ,CAST(NULL AS VARCHAR2(100)) AS RESP_PERSON_END_DT
  ,CAST(NULL AS VARCHAR2(100)) AS MBRPROFILE_RESP_PERSON_ID_NH
  ,CAST(NULL AS VARCHAR2(100)) AS GENDER_IDENTITY_OTHER
  ,
 CAST(NULL AS VARCHAR2(100)) AS SELF_IDENTITY
  ,CAST(NULL AS VARCHAR2(100)) AS SELF_IDENTITY_OTHER
  ,CAST(NULL AS VARCHAR2(100)) AS GENDER_IDENTITY

  FROM mbrprofile.member_profile mp

  INNER JOIN mbrprofile.Health_coverage hc 
  on mp.member_profile_id_nh=hc.member_profile_id_nh

  LEFT OUTER JOIN (
  SELECT M.MBI,
  M.MEMBER_ID_NH 
  FROM mbrexcep.MEMBER M
 
  INNER JOIN mbrexcep.trans_set_header tsh 
  ON M.trans_set_header_id_nh = tsh.trans_set_header_id_nh 
  AND tsh.FILE_DETAIL_ID_NH=0 
  AND tsh.trans_set_date = '20261023' ) M 
  ON Mp.MBI=M.MBI

  WHERE hc.enrollment_status_id=200004 

  AND trunc(hc.benefit_begin_dt) BETWEEN TO_DATE('01012026', 'MMDDYYYY')
  AND TO_DATE('12312026', 'MMDDYYYY')

  AND trunc(hc.benefit_end_dt)=TO_DATE('12312026', 'MMDDYYYY')
  AND
hc.term_rsn_code IS NULL

  AND(mp.member_profile_id_nh NOT IN( 
  SELECT member_profile_id_nh 
  FROM rollover_excluded_mbrs)

  OR mp.mbi NOT IN( 
  SELECT nvl(mbi, '~') AS mbi 
  FROM rollover_excluded_mbrs))

  AND mp.business_id_nh='110'
