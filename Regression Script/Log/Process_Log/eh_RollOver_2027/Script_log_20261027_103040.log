  FROM MBRPROFILE.LOWINCOMESUBSIDY A 
  WHERE NVL(DELETE_FLG,'N')='N' 
  AND NVL(LIS_REMOVED_FLG,'N')='N' 
  AND NVL(TO_CHAR(STOP_DT,'YYYY'),'2027')>='2027') LIS

  ON HC.MEMBER_PROFILE_ID_NH=LIS.MEMBER_PROFILE_ID_NH

  LEFT OUTER JOIN (
  SELECT * 
  FROM MBRPROFILE.MEMBER_LEP A 
  WHERE NVL(DELETE_FLG,'N')='N' 
  AND NVL(TO_CHAR(END_DATE,'YYYY'),'2027')>='2027' ) LEP

  ON HC.MEMBER_PROFILE_ID_NH=LEP.MEMBER_PROFILE_ID_NH

  LEFT OUTER JOIN (
  SELECT * 
  FROM MBRPROFILE.MEMBER_PPO A 
  WHERE NVL(DELETE_FLG,'N')='N' 
  AND NVL(TO_CHAR(END_DATE,'YYYY'),'2027')>='2027') PPO

  ON HC.MEMBER_PROFILE_ID_NH=PPO.MEMBER_PROFILE_ID_NH

  LEFT OUTER JOIN (
  SELECT B.MEMBER_PROFILE_ID_NH,
  A.* 
  FROM PRODCAT.VW_FIND_PLAN A 

  INNER JOIN MBRPROFILE.MBR_ADDRESS B 

  ON A.ZIP_CD=B.POSTAL_CODE 

  WHERE UPPER(B.ADDRESS_TYPE)='RESIDENTIAL' 
  AND A.FILE_YEAR=2027) FP

  ON HC.MEMBER_PROFILE_ID_NH=FP.MEMBER_PROFILE_ID_NH

  AND HC.PLAN_ID=FP.PLAN_ID

  AND HC.BUSINESS_ID_NH=FP.BUSINESS_ID_NH

  WHERE hc.Enrollment_status_id=200004 

  AND trunc(hc.benefit_begin_dt) BETWEEN TO_DATE('01012026', 'MMDDYYYY') 
  AND TO_DATE('12312026', 'MMDDYYYY')

  AND trunc(hc.benefit_end_dt)=TO_DATE('12312026', 'MMDDYYYY')
  AND
hc.term_rsn_code IS NULL

  AND(mp.member_profile_id_nh NOT IN( 
  SELECT member_profile_id_nh 
  FROM rollover_excluded_mbrs)

  OR mp.mbi NOT IN( 
  SELECT nvl(mbi, '~') AS mbi 
  FROM rollover_excluded_mbrs))

  AND mp.business_id_nh='110'
