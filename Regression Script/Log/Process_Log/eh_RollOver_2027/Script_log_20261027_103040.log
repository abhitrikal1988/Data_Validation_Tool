2026-10-27 10:30:52,875 | INFO | TestCase 21: Source [ORACLE]:WITH rollover_excluded_mbrs AS (

  SELECT 
  DISTINCT mp.mbi,
  mp.member_profile_id_nh,
  mp.business_id_nh 
  FROM mbrprofile.health_coverage hc 

  INNER JOIN mbrprofile.member_profile mp 
  ON hc.member_profile_id_nh=mp.member_profile_id_nh 

  WHERE hc.benefit_begin_dt BETWEEN TO_DATE('01012027', 'MMDDYYYY') 
  AND TO_DATE('12312027', 'MMDDYYYY') 

  AND hc.benefit_end_dt BETWEEN TO_DATE('01012027', 'MMDDYYYY') 
  AND TO_DATE('12312027', 'MMDDYYYY')

  AND hc.Enrollment_status_id IN (200004,
  200005) 

  AND sep_reason<>'SEP_ROL' 

  UNION ALL 

  SELECT 
  DISTINCT mbi,
  mbr.member_profile_id_nh,
  mbr.business_id_nh 
  FROM mbrexcep.member mbr

  INNER JOIN mbrexcep.member_error mbr_er 
  ON mbr.member_id_nh=mbr_er.member_id_nh 
  AND mbr_er.error_status_id=170105 

  INNER JOIN mbrexcep.health_coverage hc 
  ON mbr.member_id_nh=hc.member_id_nh 

  WHERE mbr.maintenance_type_code='021' 

  AND TO_DATE(hc.benefit_begin_dt DEFAULT NULL 
  ON CONVERSION ERROR, 'YYYYMMDD')BETWEEN TO_DATE('01012027', 'MMDDYYYY')
  AND TO_DATE('12312027', 'MMDDYYYY')

  AND TO_DATE(hc.benefit_end_dt DEFAULT NULL 
  ON CONVERSION ERROR, 'YYYYMMDD') BETWEEN TO_DATE('01012027', 'MMDDYYYY') 
  AND TO_DATE('12312027', 'MMDDYYYY')

  UNION ALL 

  SELECT 
  DISTINCT mp.mbi,
  mp.member_profile_id_nh,
  mp.business_id_nh 
  FROM mbrprofile.member_profile mp

  INNER JOIN mbrprofile.health_coverage hc 
  ON mp.member_profile_id_nh=hc.member_profile_id_nh

  WHERE hc.Enrollment_status_id=200004 

  AND trunc(hc.benefit_begin_dt) BETWEEN TO_DATE('01012026', 'MMDDYYYY') 
  AND TO_DATE('12312026', 'MMDDYYYY')

  AND trunc(hc.benefit_end_dt)=TO_DATE('12312026', 'MMDDYYYY') 

  AND hc.term_rsn_code IS NULL 

  AND hc.plan_id='H3551002000'

  UNION ALL

  SELECT 
  DISTINCT mp.mbi,
  mp.member_profile_id_nh,
  mp.business_id_nh 
  FROM mbrprofile.member_profile mp 

  INNER JOIN mbrprofile.health_coverage hc 
  ON mp.member_profile_id_nh=hc.member_profile_id_nh 

  INNER JOIN mbrprofile.mbr_address ma 
  ON mp.member_profile_id_nh=ma.member_profile_id_nh 

  AND upper(ma.address_type)='RESIDENTIAL'

  AND upper(ma.county)='PIMA' 

  WHERE hc.Enrollment_status_id=200004 

  AND trunc(hc.benefit_begin_dt) BETWEEN TO_DATE('01012026', 'MMDDYYYY')
  AND TO_DATE('12312026', 'MMDDYYYY') 

  AND trunc(hc.benefit_end_dt)=TO_DATE('12312026', 'MMDDYYYY')

  AND hc.term_rsn_code IS NULL

  AND hc.plan_id LIKE'H3551004%')


  SELECT 'mbrexcep.PROVIDER_NAME' AS tbl
  ,COUNT(*) AS RECORD_COUNT

  FROM (

  SELECT * 
  FROM (

  SELECT 
  DISTINCT M.HEALTH_COVERAGE_ID_NH,
  CAST(NULL AS VARCHAR2(100)) AS ASSIGNED_NUMBER,
  PN.PROVIDER_TYPE AS ENTITY_ID_CODE,
  CAST(NULL AS VARCHAR2(100)) AS ENTITIY_TYPE_QUALF,
  PN.NAME_LAST_ORG_NAME,
  PN.NAME_FIRST,
  
 PN.NAME_MIDDLE,
  PN.NAME_PREFIX,
  PN.NAME_SUFFIX,
  'XX' AS ID_CODE_QUALF,
  PN.NPI AS ID_CODE,
  pcp.ENTITY_RELAT_CODE AS ENTITY_RELAT_CODE,
  '20270101' AS EFFECTIVE_DATE,
  PCP.MAINT_REASON_CODE,
  
 PA.ADDRESS AS ADDRESS_INFO_1,
  PA.ADDRESS_1 AS ADDRESS_INFO_2,
  PA.CITY_NAME,
  PA.STATE_CODE AS STATE_PROV_CODE,
  PA.POSTAL_CODE AS POSTAL_CODE,
  PA.COUNTRY_CODE,
  CAST(NULL AS VARCHAR2(100)) AS COUNTRY_SUB_CODE,
  
 PCP.CURRENT_PCP,
  PN.CUSTOM_ID,
  PN.VENDOR_PROVIDER_ID,
  CAST(NULL AS VARCHAR2(10)) AS END_DT,
  CAST(NULL AS NUMBER) AS MBRPROFILE_MEMBER_PCP_ID_NH,
  
 ROW_NUMBER() OVER(PARTITION BY PCP.MEMBER_PROFILE_ID_NH 
  ORDER BY PCP.END_DT DESC ,PCP.START_DT DESC ,PCP.MEMBER_PCP_ID_NH DESC) AS RNK

  FROM mbrprofile.member_profile mp

  INNER JOIN mbrprofile.health_coverage hc 
  ON mp.member_profile_id_nh=hc.member_profile_id_nh

  INNER JOIN mbrprofile.MEMBER_PCP PCP 
  ON MP.member_profile_id_nh=PCP.member_profile_id_nh 
  AND HC.HEALTH_COVERAGE_ID_NH=PCP.HEALTH_COVERAGE_ID_NH

  LEFT OUTER JOIN mbrprofile.PROVIDER_NAME PN 
  ON PCP.PROVIDER_INFO_id_nh=PN.PROVIDER_INFO_id_nh

  LEFT OUTER JOIN mbrprofile.PROVIDER_ADDRESS PA 
  ON PN.PROVIDER_INFO_id_nh=PA.PROVIDER_INFO_id_nh 

  LEFT OUTER JOIN (
  SELECT M.MBI,
  M.MEMBER_ID_NH,
  hc.HEALTH_COVERAGE_ID_NH 
  FROM mbrexcep.MEMBER M
 
  INNER JOIN mbrexcep.trans_set_header tsh 
  ON M.trans_set_header_id_nh = tsh.trans_set_header_id_nh 
  AND tsh.FILE_DETAIL_ID_NH=0 
  AND tsh.trans_set_date = '20261023'
 
  INNER JOIN mbrexcep.health_coverage HC 
  ON M.MEMBER_ID_NH=hc.MEMBER_ID_NH) M 
  ON Mp.MBI=M.MBI

  WHERE hc.enrollment_status_id=200004 

  AND trunc(hc.benefit_begin_dt) BETWEEN TO_DATE('01012026', 'MMDDYYYY')
  AND TO_DATE('12312026', 'MMDDYYYY')

  AND trunc(hc.benefit_end_dt)=TO_DATE('12312026', 'MMDDYYYY')
  AND
hc.term_rsn_code IS NULL

  AND(mp.member_profile_id_nh NOT IN( 
  SELECT member_profile_id_nh 
  FROM rollover_excluded_mbrs)

  OR mp.mbi NOT IN( 
  SELECT nvl(mbi, '~') AS mbi 
  FROM rollover_excluded_mbrs))

  AND mp.business_id_nh='110' 

  AND NVL(PCP.END_DT, TO_DATE('31122026', 'DDMMYYYY'))>SYSDATE

  AND NVL(PCP.END_DT, TO_DATE('31122099', 'DDMMYYYY'))>=PCP.START_DT 

  AND NVL(PCP.DELETE_FLG,'N') ='N' )

  WHERE RNK=1
)
