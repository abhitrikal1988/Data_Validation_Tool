  AND mp.business_id_nh='110'

  AND NVL(PCP.DELETE_FLG,'N') ='N'

  AND NVL(PCP.END_DT,TO_DATE('12312099','MMDDYYYY'))>SYSDATE

  AND NVL(PCP.END_DT,TO_DATE('12312099','MMDDYYYY'))>PCP.START_DT
)

  WHERE RNK=1)
