         "columns": [["SUBSC_EB_ENTITY_CODE", "ENTITY_CODE"], ["SUBSC_EB_ENTITY_TYPE", "ENTITY_TYPE"],
                     ["SUBSC_EB_ENTITY_LAST_NAME", "ENTITY_LAST_NAME"], ["SUBSC_EB_ENTITY_FIRST_NAME", "ENTITY_FIRST_NAME"],
