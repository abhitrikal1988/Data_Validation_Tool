                     ["EB08_PERCNT_DEC", "BENEFIT_PERCENT"], ["EB09_QUANTITY_QUAL", "QUANTITY_QUALIFIER"],
                     ["EB10_QUANTITY", "QUANTITY"], ["EB11_RESP_CODE", "AUTH_REQUIRED"],
                     ["EB12_RESP_CODE", "IN_PLAN_NETWORK"],
                     ["EB13_ID_QUAL", "PROCEDURE_QUALIFIER"], ["EB13_PROCEDURE_CODE", "PROCEDURE_CODE"],
                     ["EB13_MOD1", "MODIFIER_1"], ["EB13_MOD2", "MODIFIER_2"], ["EB13_MOD3", "MODIFIER_3"],
                     ["EB13_MOD4", "MODIFIER_4"], ["EB13_DESC", "PROCEDURE_DESC"],
                     ["EB14_DIAGCODE_POINTER1", "DIAG_POINTER_1"], ["EB14_DIAGCODE_POINTER2", "DIAG_POINTER_2"],
                     ["EB14_DIAGCODE_POINTER3", "DIAG_POINTER_3"], ["EB14_DIAGCODE_POINTER4", "DIAG_POINTER_4"]]}
      ]
    },
    "RECON.EDI_271_SERVICETYPE_CODE_EB": {
      "id": "EDI_271_SERVICETYPE_CODE_EB_ID_NH",
      "parent": {"table": "RECON.EDI_271_SUBSCRIBER_EB", "fk": "EDI_271_SUBSCRIBER_EB_ID_NH"},
      "tests": [
